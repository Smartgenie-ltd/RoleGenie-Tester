# Copy this file to .env (same folder) and fill in each value. Never share or commit .env.
# Required: Jev API key, from your Jev account (used to judge each requirement against your master CV).
TYPESAFE_API_KEY=
# Optional: Adzuna app id, free developer key from https://developer.adzuna.com (only for the daily job scan's Adzuna source).
ADZUNA_APP_ID=
# Optional: Adzuna app key, from the same Adzuna developer account.
ADZUNA_APP_KEY=
